# Leave LLM_API_KEY empty to use the built-in rule-based agent.
LLM_API_KEY=
# Optional: for Groq / OpenRouter etc. set the base URL and model.
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# fake = no real payments. paypal = PayPal sandbox Payouts.
PAYMENTS_BACKEND=fake
# PayPal sandbox REST app credentials (developer.paypal.com).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox account email of each supplier, comma separated.
PAYPAL_SUPPLIER_EMAILS=sup_a=supplier-a@example.com,sup_b=supplier-b@example.com
# Optional overrides.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
